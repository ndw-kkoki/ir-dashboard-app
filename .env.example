# Analysis Dashboard App 環境変数設定例
# このファイルをコピーして .env ファイルを作成してください

# アプリケーション基本設定
DEBUG=true
HOST=127.0.0.1
PORT=8050

# Google Drive認証設定
# ローカル開発: OAuth認証を使用
USE_SERVICE_ACCOUNT=false
CREDENTIALS_FILE=credentials.json

# 本番環境: サービスアカウント認証を使用
# USE_SERVICE_ACCOUNT=true
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google Drive フォルダID設定
# 各フォルダのGoogle DriveのURLからフォルダIDを取得して設定してください
# 例: https://drive.google.com/drive/folders/1ABC...XYZ の場合、フォルダIDは 1ABC...XYZ
SEGMENT_DATA_FOLDER_ID=your_segment_data_folder_id_here
REVENUE_OVERVIEW_FOLDER_ID=your_revenue_overview_folder_id_here
AI_SUMMARY_FOLDER_ID=your_ai_summary_folder_id_here

# アプリケーション詳細設定
DEFAULT_FONT_SIZE=14
CHATBOT_MAX_HISTORY=10
